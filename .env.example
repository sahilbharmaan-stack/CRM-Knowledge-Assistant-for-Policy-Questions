# Copy to .env (git-ignored). On Vercel/Render set these in the dashboard instead.
# Provider: groq | mock (offline) | gemini | anthropic | openai
# Gemini use is approved by the instructor (see docs/approval/APPROVALS.md).
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=20

JWT_SECRET=change-me-to-a-long-random-string
# Initial administrator (change these BEFORE first launch for a real deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@CRM2026!
ADMIN_DISPLAY_NAME=CRM Administrator
# Set to 1 once to repair/reset the existing administrator password, then set it back to 0.
ADMIN_PASSWORD_RESET=0
# Synthetic 30-day activity history so the analytics charts have data on first run (set 1, runs once)
SEED_DEMO_DATA=0
# Optional demo accounts
SEED_DEMO_USERS=0
DEMO_PASSWORD=change-me
# Comma separated. Add your Vercel URL when frontend and backend are deployed separately.
CORS_ORIGINS=http://localhost:5173
# Frontend only (frontend/.env): backend URL when split deploy, e.g. https://xxx.onrender.com
# VITE_API_URL=
